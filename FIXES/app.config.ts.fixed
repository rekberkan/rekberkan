/**
 * KAHADE APPLICATION CONFIGURATION
 * Centralized configuration for multi-subdomain deployment
 * 
 * FIX: Added safer fallbacks to prevent redirect to external domains
 */

// Application modes
export type AppMode = 'landing' | 'app' | 'admin';

// Get current app mode from environment or detect from hostname
export function getAppMode(): AppMode {
  // First check environment variable
  const envMode = import.meta.env.VITE_APP_MODE as AppMode;
  if (envMode && ['landing', 'app', 'admin'].includes(envMode)) {
    return envMode;
  }

  // Auto-detect from hostname
  const hostname = window.location.hostname;
  
  if (hostname.startsWith('admin.')) {
    return 'admin';
  }
  if (hostname.startsWith('app.')) {
    return 'app';
  }
  
  // Default to landing for main domain or localhost
  return 'landing';
}

// FIX: Helper function to validate URL is not a placeholder
function getValidUrl(envUrl: string | undefined, fallback: string): string {
  // Check if URL contains placeholder domain
  if (envUrl && !envUrl.includes('domain.com') && !envUrl.includes('placeholder')) {
    return envUrl;
  }
  // Return fallback (current origin) if placeholder detected
  console.warn(`Invalid URL detected: ${envUrl}. Using fallback: ${fallback}`);
  return fallback;
}

// Application URLs - FIX: Added validation and safer fallbacks
export const APP_URLS = {
  landing: getValidUrl(
    import.meta.env.VITE_LANDING_URL, 
    window.location.origin
  ),
  app: getValidUrl(
    import.meta.env.VITE_APP_URL, 
    window.location.origin
  ),
  admin: getValidUrl(
    import.meta.env.VITE_ADMIN_URL, 
    window.location.origin
  ),
  api: getValidUrl(
    import.meta.env.VITE_API_URL, 
    `${window.location.origin}/api/v1`
  ),
};

// Cookie configuration
export const COOKIE_CONFIG = {
  domain: import.meta.env.VITE_COOKIE_DOMAIN || 'localhost',
  secure: import.meta.env.PROD,
  sameSite: 'lax' as const,
};

// Feature flags
export const FEATURES = {
  debug: import.meta.env.VITE_ENABLE_DEBUG === 'true',
  analytics: import.meta.env.VITE_ENABLE_ANALYTICS === 'true',
};

// Route configuration per app mode
export const ROUTES_CONFIG = {
  landing: {
    home: '/',
    about: '/about',
    howItWorks: '/how-it-works',
    contact: '/contact',
    login: '/login',
    register: '/register',
    forgotPassword: '/forgot-password',
  },
  app: {
    dashboard: '/',
    transactions: '/transactions',
    newTransaction: '/transactions/new',
    transactionDetail: '/transactions/:id',
    wallet: '/wallet',
    notifications: '/notifications',
    profile: '/profile',
    settings: '/settings',
  },
  admin: {
    dashboard: '/',
    users: '/users',
    transactions: '/transactions',
    disputes: '/disputes',
    auditLogs: '/audit-logs',
    settings: '/settings',
  },
};

// Navigation helper - redirect to correct subdomain
// FIX: Added validation before redirect
export function navigateToApp(path: string = '/'): void {
  const targetUrl = `${APP_URLS.app}${path}`;
  // Only redirect if URL is valid (not placeholder)
  if (!targetUrl.includes('domain.com')) {
    window.location.href = targetUrl;
  } else {
    console.error('Cannot navigate: Invalid APP_URL configuration');
    // Stay on current page instead of redirecting to invalid domain
  }
}

export function navigateToAdmin(path: string = '/'): void {
  const targetUrl = `${APP_URLS.admin}${path}`;
  if (!targetUrl.includes('domain.com')) {
    window.location.href = targetUrl;
  } else {
    console.error('Cannot navigate: Invalid ADMIN_URL configuration');
  }
}

export function navigateToLanding(path: string = '/'): void {
  const targetUrl = `${APP_URLS.landing}${path}`;
  if (!targetUrl.includes('domain.com')) {
    window.location.href = targetUrl;
  } else {
    console.error('Cannot navigate: Invalid LANDING_URL configuration');
  }
}

// Check if current user has access to admin
export function canAccessAdmin(user: { role?: string; isAdmin?: boolean } | null): boolean {
  if (!user) return false;
  return user.role === 'ADMIN' || user.isAdmin === true;
}

export default {
  getAppMode,
  APP_URLS,
  COOKIE_CONFIG,
  FEATURES,
  ROUTES_CONFIG,
  navigateToApp,
  navigateToAdmin,
  navigateToLanding,
  canAccessAdmin,
};
