# ============================================================================
# KAHADE FRONTEND - DEVELOPMENT ENVIRONMENT
# ============================================================================
# FIX: Corrected API port to match backend default (3000)
# ============================================================================

# API Configuration
# IMPORTANT: Backend runs on port 3000 by default
VITE_API_URL=http://localhost:3000/api/v1

# Application Mode (landing | app | admin)
VITE_APP_MODE=landing

# Domain Configuration (Development)
VITE_BASE_DOMAIN=localhost
VITE_LANDING_URL=http://localhost:5000
VITE_APP_URL=http://localhost:5001
VITE_ADMIN_URL=http://localhost:5002

# Cookie Configuration
VITE_COOKIE_DOMAIN=localhost

# Feature Flags
VITE_ENABLE_DEBUG=true
VITE_ENABLE_ANALYTICS=false

# Analytics Configuration (optional - leave empty to disable)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
