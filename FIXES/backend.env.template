# ============================================================================
# KAHADE BACKEND - DEVELOPMENT ENVIRONMENT
# ============================================================================
# Copy this to kahade-backend/.env and fill in the values
# ============================================================================

# Environment
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Application
APP_NAME=Kahade API
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5000

# Database (PostgreSQL)
# Replace with your database credentials
DATABASE_URL=postgresql://postgres:password@localhost:5432/kahade_dev?schema=public

# JWT Authentication
# IMPORTANT: Generate secure random values for production
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=your-super-secret-jwt-key-min-64-chars-for-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-different-super-secret-refresh-key-min-64-chars
JWT_REFRESH_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=3600
REDIS_SESSION_TTL=86400

# CORS Configuration
# CRITICAL: Must match frontend URLs exactly
CORS_ORIGIN=http://localhost:5000,http://localhost:5001,http://localhost:5002
CORS_CREDENTIALS=true

# Cookie Secret
COOKIE_SECRET=your-cookie-secret-min-32-chars

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Trust Proxy
TRUST_PROXY_HOPS=1

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_GRAPHQL=false
ENABLE_WEBSOCKET=false

# Logging
LOG_LEVEL=debug

# ============================================================================
# OPTIONAL SERVICES (can be left empty for development)
# ============================================================================

# Email Service
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@kahade.local
MAIL_FROM_NAME=Kahade

# Payment Gateway (Sandbox)
PAYMENT_GATEWAY=midtrans
PAYMENT_ENVIRONMENT=sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf
UPLOAD_DEST=./uploads

# Blockchain (Testnet)
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_RPC_URL=
CHAIN_ID=11155111
SMART_CONTRACT_ADDRESS=
PRIVATE_KEY=

# ============================================================================
# PRODUCTION CHECKLIST
# ============================================================================
# Before deploying to production:
# [ ] Change NODE_ENV to production
# [ ] Use strong, randomly generated JWT secrets (64+ chars)
# [ ] Enable SSL for database connection
# [ ] Set CORS_ORIGIN to exact production domains
# [ ] Set ENABLE_SWAGGER=false
# [ ] Configure proper email service
# [ ] Set up Redis with password and TLS
# [ ] Use KMS/HSM for private key storage
# ============================================================================
