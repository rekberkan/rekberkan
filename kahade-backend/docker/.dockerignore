# ============================================================================
# KAHADE BACKEND - DOCKER IGNORE FILE
# Prevents sensitive files from being included in Docker images
# ============================================================================

# Environment files (CRITICAL - contains secrets)
.env
.env.*
!.env.example

# Git
.git
.gitignore
.gitattributes

# IDE and Editor
.idea
.vscode
*.swp
*.swo
*~

# Node modules (will be installed fresh)
node_modules

# Build outputs
dist
build
coverage

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test files
test
tests
__tests__
*.test.ts
*.spec.ts
jest.config.*
vitest.config.*

# Documentation
docs
*.md
!README.md

# Development files
docker-compose*.yml
Dockerfile.dev
*.local

# Uploads (user data)
uploads
temp

# Secrets and certificates
*.pem
*.key
*.crt
*.p12
*.pfx
secrets
ssl

# OS files
.DS_Store
Thumbs.db

# Monitoring configs (separate deployment)
monitoring

# Deploy scripts (not needed in image)
deploy

# TypeScript source maps
*.map

# Prisma migrations (handled separately)
prisma/migrations

# Audit and security reports
*AUDIT*.md
SECURITY*.md
