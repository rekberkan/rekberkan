# ============================================================================
# KAHADE FRONTEND - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env.development and .env.production
# Adjust values based on your environment
# ============================================================================

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Backend API URL - MUST include full URL with protocol
# Development: Use localhost or local IP
# Production: Use your actual API domain
VITE_API_URL=http://localhost:3001/api/v1

# ============================================================================
# APPLICATION MODE
# ============================================================================
# Determines which frontend to build/serve
# Options: landing | app | admin
# - landing: Public landing page (domain.com)
# - app: User application (app.domain.com)
# - admin: Admin panel (admin.domain.com)
VITE_APP_MODE=landing

# ============================================================================
# DOMAIN CONFIGURATION
# ============================================================================
# Base domain for the application (without protocol)
VITE_BASE_DOMAIN=kahade.com

# Full URLs for each subdomain
VITE_LANDING_URL=https://kahade.com
VITE_APP_URL=https://app.kahade.com
VITE_ADMIN_URL=https://admin.kahade.com

# ============================================================================
# COOKIE CONFIGURATION
# ============================================================================
# Cookie domain for cross-subdomain authentication
# Must start with a dot for subdomain sharing
VITE_COOKIE_DOMAIN=.kahade.com

# ============================================================================
# FEATURE FLAGS
# ============================================================================
VITE_ENABLE_DEBUG=false
VITE_ENABLE_ANALYTICS=false
