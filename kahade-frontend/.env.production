# ============================================================================
# KAHADE FRONTEND - PRODUCTION ENVIRONMENT
# ============================================================================
# IMPORTANT: Replace domain.com with your actual domain before deployment

# API Configuration
VITE_API_URL=https://api.domain.com/api/v1

# Application Mode (landing | app | admin)
# This will be set during build for each subdomain
VITE_APP_MODE=landing

# Domain Configuration
VITE_BASE_DOMAIN=domain.com
VITE_LANDING_URL=https://domain.com
VITE_APP_URL=https://app.domain.com
VITE_ADMIN_URL=https://admin.domain.com

# Cookie Configuration
VITE_COOKIE_DOMAIN=.domain.com

# Feature Flags
VITE_ENABLE_DEBUG=false
VITE_ENABLE_ANALYTICS=true
