entrypoint = "index.js"
modules = ["nodejs-20"]
hidden = [".config", "package-lock.json"]

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "package.json", "package-lock.json"]

[nix]
channel = "stable-24_11"
packages = ["unzip"]

[deployment]
run = ["node", "index.js"]
deploymentTarget = "autoscale"
ignorePorts = false

[agent]
expertMode = true

[userenv]

[userenv.shared]
NODE_ENV = "development"
PORT = "3001"
API_PREFIX = "api"
APP_NAME = "Kahade API"
JWT_SECRET = "dev-jwt-secret-min-64-chars-secure-random-value-for-development-only"
JWT_EXPIRATION = "1d"
JWT_REFRESH_SECRET = "dev-jwt-refresh-secret-min-64-chars-secure-random-value-for-development"
JWT_REFRESH_EXPIRATION = "7d"
CORS_ORIGIN = "*"
CORS_CREDENTIALS = "true"
ENABLE_SWAGGER = "true"
LOG_LEVEL = "debug"
COOKIE_SECRET = "dev-cookie-secret-32chars-minimum"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd kahade-backend && npm run build && npm run start:prod"
waitForPort = 3001

[[workflows.workflow]]
name = "Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd kahade-frontend && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 5000
